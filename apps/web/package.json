{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Surety web app: credit board, voting, lending, borrowing, sponsoring, auctions and proof.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sdk": "pnpm --filter @surety/sdk build",
    "snapshot": "node scripts/snapshot.ts",
    "dev": "pnpm run sdk && node scripts/snapshot.ts --if-missing && next dev",
    "build": "pnpm run sdk && node scripts/snapshot.ts && next build && node scripts/fix-export.ts && node scripts/build-api.ts",
    "start": "npx serve@14.2.5 out",
    "lint": "eslint .",
    "typecheck": "pnpm run sdk && next typegen && tsc --noEmit",
    "test": "node --test api/starter.test.ts",
    "check:load": "node scripts/check-load.ts",
    "stage": "node scripts/stage-deploy.ts"
  },
  "dependencies": {
    "@mezo-org/passport": "0.17.2",
    "@surety/sdk": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  }
}
